    "README.md",
    "SPEC.md",
    "cordis.patch.yml",
    "index.js",
    "lib",
    "selfcheck-vision.mjs",
    "icon.svg",
    "locale"
  ],
  "scripts": {
    "selfcheck": "node selfcheck-vision.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
