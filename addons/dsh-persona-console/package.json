{
  "name": "dsh-persona-console",
  "version": "0.4.0",
  "private": true,
  "description": "人格框架台：总模块／模块功能实现／四组附加插件（八大人格插件・器官・对外接口・其他），每组带实时启停勾选，写到 Loader 的条目上，不用重启。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
