{
  "name": "dsh-persona-console",
  "version": "0.3.3",
  "private": true,
  "description": "人格框架台：第一部分本体与模块正文，第二部分模块功能实现（探索/成果/日记/清扫的实现件都在这一栏，无独立包的标功能已实现），第三部分其余附加插件",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
