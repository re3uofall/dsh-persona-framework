{
  "name": "dsh-persona-energy",
  "version": "0.3.0",
  "private": true,
  "description": "把吃、睡、耗压成一个 0..1 的电量：三个槽各按自己的半衰期衰减，合成时取短板，再乘昼夜节律",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "环境提示词.md",
    "selfcheck.mjs",
    "client.js"
  ],
  "scripts": {
    "selfcheck": "node selfcheck.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
