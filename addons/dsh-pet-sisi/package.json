    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "files": ["index.js", "lib", "locale", "icon.svg", "cordis.patch.yml", "README.md"],
