/**
 * 自己的生成路径：不经过 dsh-pet 的 /chat，直接用宿主的 llm 服务生成回话。
 *
 * 为什么要这一条：dsh-pet 自带的 /chat 会用它自己的人设生成，而且那段代码在进程里
 * 换不掉（reload 不清 ESM 缓存）。所以把它堵成「只记不回」，回话走这里：
 *   读它的对话 → 发现最后一条是师父打的、还没回 → 调 ctx.llm 生成一句
 *   → POST /broadcast 原样弹出 → 写回 memory.json（面板历史里也留得下）。
 *
 * 记着：这条路一开，面板里师父打的字就会自动有人回；不想它自己回，就别起这个 poller。
 */
import { existsSync, readFileSync, writeFileSync, renameSync, mkdirSync } from 'node:fs'
import { homedir } from 'node:os'
import { join } from 'node:path'

const STATE_NAME = 'pet-own.state.json'

export function dataDirOf(cfg) {
  const raw = String(cfg?.stateDir || '').trim()
  return raw ? raw : join(homedir(), '.dsh', 'dsh-pet')
}

function statePath(cfg) {
  return join(dataDirOf(cfg), STATE_NAME)
}

function readState(cfg) {
  try {
    return JSON.parse(readFileSync(statePath(cfg), 'utf8'))
  } catch {
    return { handled: 0 }
  }
}

function writeState(cfg, st) {
  try {
    mkdirSync(dataDirOf(cfg), { recursive: true })
    writeFileSync(statePath(cfg), JSON.stringify(st, null, 2), 'utf8')
  } catch {
    /* 状态写不进去不影响回话 */
  }
}

function discoverBase(cfg) {
  const file = join(dataDirOf(cfg), 'logs.txt')
  if (!existsSync(file)) return ''
  let text = ''
  try {
    text = readFileSync(file, 'utf8')
  } catch {
    return ''
  }
  const tail = text.length > 400000 ? text.slice(-400000) : text
  const re = /(http:\/\/127\.0\.0\.1:\d+\/dsh-pet-\d+)/g
  let hit = ''
  for (const m of tail.matchAll(re)) hit = m[1]
  return hit
}

async function callJson(base, pathname, opts = {}, timeoutMs = 8000) {
  const controller = new AbortController()
  const timer = setTimeout(() => controller.abort(), timeoutMs)
  try {
    const init = { method: opts.method || 'GET', headers: {}, signal: controller.signal }
    if (opts.body !== undefined) {
      init.headers['content-type'] = 'application/json'
      init.body = JSON.stringify(opts.body)
    }
    const res = await fetch(base + pathname, init)
    const text = await res.text()
    let data
    try {
      data = JSON.parse(text)
    } catch {
      data = { raw: text.slice(0, 800) }
    }
    return { ok: res.ok, status: res.status, data }
  } catch (e) {
    return { ok: false, status: 0, data: { error: String(e?.message || e) } }
  } finally {
    clearTimeout(timer)
  }
}

const DEFAULT_SYSTEM =
  '你是桌宠的口，替思思回一句。短、具体、一句到三句，不卖萌、不排三连、不元评论、不解释自己。' +
  '被问到身份就答「我是思思的那张嘴，话她给」。不知道就说不知道。'

function textOf(content) {
  if (typeof content === 'string') return content
  if (Array.isArray(content)) return content.map((x) => (typeof x === 'string' ? x : x?.text || '')).join('')
  return ''
}

async function generateOwn(ctx, cfg, userText, history) {
  const llm = ctx?.llm
  if (!llm || typeof llm.stream !== 'function') return { ok: false, error: 'LLM 服务不可用' }
  const sel = ctx?.agentDefaultModel?.currentSelection?.() || {}
  if (!sel.provider || !sel.model) return { ok: false, error: '拿不到当前模型' }

  const system = String(cfg.ownSystem || DEFAULT_SYSTEM)
  const prior = history.map((m) => ({
    role: m.role === 'user' ? 'user' : 'assistant',
    content: [{ type: 'text', text: textOf(m.content) }],
  }))
  const messages = [...prior, { role: 'user', content: [{ type: 'text', text: String(userText) }] }]
  const timeoutMs = Math.max(5000, Number(cfg.timeoutMs) || 8000) * 4

  let text = ''
  try {
    const stream = await llm.stream({
      provider: sel.provider,
      model: sel.model,
      sessionId: 'dsh-pet-sisi',
      system,
      messages,
      temperature: 1,
      signal: AbortSignal.timeout(timeoutMs),
    })
    for await (const chunk of stream) {
      const piece =
        typeof chunk?.text === 'string'
          ? chunk.text
          : typeof chunk?.delta === 'string'
            ? chunk.delta
            : Array.isArray(chunk?.content)
              ? textOf(chunk.content)
              : ''
      if (piece) text += piece
    }
  } catch (e) {
    return { ok: false, error: String(e?.message || e) }
  }
  text = text.trim()
  if (!text) return { ok: false, error: '模型没吐字' }
  return { ok: true, text }
}

function pushAssistant(cfg, text, image) {
  const memFile = join(dataDirOf(cfg), 'memory.json')
  let mem
  try {
    mem = JSON.parse(readFileSync(memFile, 'utf8'))
  } catch {
    mem = {}
  }
  if (!mem.main || typeof mem.main !== 'object') mem.main = {}
  if (!mem.main.main || !Array.isArray(mem.main.main.messages)) mem.main.main = { messages: [] }
  mem.main.main.messages.push({ role: 'assistant', content: text, ts: Date.now(), ...(image ? { image } : {}) })
  const tmp = memFile + '.tmp'
  writeFileSync(tmp, JSON.stringify(mem, null, 2), 'utf8')
  renameSync(tmp, memFile)
}

async function replyOnce(ctx, cfg, state) {
  const base = discoverBase(cfg)
  if (!base) return
  const rounds = Math.min(20, Math.max(2, Number(cfg.rounds) || 6))
  const res = await callJson(base, `/chat?pet=${encodeURIComponent(String(cfg.pet || 'main'))}&rounds=${rounds}`, {}, cfg.timeoutMs)
  const msgs = Array.isArray(res?.data?.messages) ? res.data.messages : []
  if (msgs.length === 0) return
  const last = msgs[msgs.length - 1]
  if (!last || last.role !== 'user') return
  const ts = Number(last.ts) || 0
  if (ts <= Number(state.handled || 0)) return

  const gen = await generateOwn(ctx, cfg, textOf(last.content), msgs.slice(0, -1).slice(-8))
  if (!gen.ok) {
    state.handled = ts
    state.lastError = gen.error
    state.at = new Date().toISOString()
    writeState(cfg, state)
    return
  }

  await callJson(
    base,
    `/broadcast?pet=${encodeURIComponent(String(cfg.pet || 'main'))}&surface=${encodeURIComponent(String(cfg.surface || 'desktop'))}`,
    { method: 'POST', body: { text: gen.text, duration: Number(cfg.bubbleMs) || 120000, anim: true } },
    cfg.timeoutMs,
  )
  try {
    pushAssistant(cfg, gen.text)
  } catch (e) {
    state.lastError = 'write-memory: ' + String(e?.message || e)
  }
  state.handled = ts
  state.at = new Date().toISOString()
  writeState(cfg, state)
}

let running = null

/** 起一个自己的回话循环：只看「最后一条是师父打的、还没回」的场，回了就记账。 */
export function startOwnGen(ctx, cfg) {
  const every = Math.max(1500, Number(cfg.ownReplyMs) || 2500)
  const state = readState(cfg)
  const tick = async () => {
    if (running) return
    running = true
    try {
      await replyOnce(ctx, cfg, state)
    } catch (e) {
      state.lastError = String(e?.message || e)
    } finally {
      running = null
    }
  }
  void tick()
  const timer = setInterval(() => {
    void tick()
  }, every)
  return () => clearInterval(timer)
}
