{
  "name": "dsh-persona-mouth",
  "version": "0.1.0",
  "private": true,
  "description": "嘴：真送一句话出去（发件箱/命令/HTTP），把话与通道回执落进嘴账；送完还没说出口的，下一步注一行——先写账再说话，不重试、不猜通道",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "环境提示词.md",
    "selfcheck.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "selfcheck": "node selfcheck.mjs"
  }
}
