{
  "name": "dsh-persona-module-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "模块「适配」长成一个插件：换机器、换宿主、换读者，核心不许改，接口改到能对上。",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "module": {
      "id": "adapter",
      "title": "适配"
    }
  },
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "module.md",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md"
  ]
}
