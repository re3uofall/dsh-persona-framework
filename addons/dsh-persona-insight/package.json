{
  "name": "dsh-persona-insight",
  "version": "0.1.0",
  "private": true,
  "description": "感悟：不是判断，是非理性的体会。随心的那半句落进 growth/感悟/，跟日记成果同处，但不同格。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "核心精神.md",
    "selfcheck.mjs",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
