{
  "name": "dsh-persona-diary",
  "version": "1.3.4",
  "private": true,
  "description": "日记本：三本——公开（能拿给人看的判断）／私密（拿不准、不给人看的）／记录（记事：谁、何时、做了什么、结果如何）。按天摆、按类筛、按词找",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
