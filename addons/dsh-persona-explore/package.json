{
  "name": "dsh-persona-explore",
  "version": "0.7.1",
  "private": true,
  "description": "主动探索：范围/方式/平台三维目录可增改；触发器六条（队列空/连续无留/超期/骰子/一次性唤醒/闲置/二次触发）真落账；左侧栏一页看判断、队列与触发账",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "selfcheck.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
