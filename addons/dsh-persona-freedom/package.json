{
  "name": "dsh-persona-freedom",
  "version": "0.5.0",
  "private": true,
  "description": "自己给自己划时间：粗糙日程（有钟点、要完成）与精细日程（随时可做、可跳过）分开，每天一份想做的事，DND、自由空间与虚拟机配合",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "环境提示词.md",
    "selfcheck.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "selfcheck": "node selfcheck.mjs"
  }
}
