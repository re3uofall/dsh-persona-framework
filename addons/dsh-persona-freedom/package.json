{
  "name": "dsh-persona-freedom",
  "version": "0.4.0",
  "private": true,
  "description": "自己给自己划时间：固定事与弹性事、自由空间（一台自己的虚拟机）、自由时间（粗糙作息表 + 精细骨架留白）、免打扰；到点才提一句，弹性事不催不记连续",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "环境提示词.md",
    "selfcheck.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "selfcheck": "node selfcheck.mjs"
  }
}
