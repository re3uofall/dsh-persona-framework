{
  "name": "dsh-persona-hand",
  "version": "0.1.1",
  "private": true,
  "description": "手：真跑一条命令、把动作与回执落进手账；动完还没说出口的，下一步注一行——先写账再说话，不重试、不猜命令",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "环境提示词.md",
    "selfcheck.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "selfcheck": "node selfcheck.mjs"
  }
}
