{
  "name": "dsh-persona-grow",
  "version": "1.6.0",
  "private": true,
  "description": "每轮把人格文件注入上下文，并从你的纠正里长出新条目：带版本、可回滚、不覆盖旧条",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "selfcheck.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
