{
  "name": "dsh-persona-framework",
  "version": "5.21.0",
  "description": "人格框架插件：88 个模块的通用人格骨架，随人格注入、不覆盖人格文件；模块正文按天轮转读完（一天 88 篇、元协调固定先读），设置页有「开始注入」一次性读全；自带功能自检、结构自检、槽位体检，程序触发器每轮现算、框架语言必过检查每次注入都跑。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./framework/FRAMEWORK.md": "./framework/FRAMEWORK.md"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "framework",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "selfcheck.mjs",
    "RELEASE.md",
    "CHANGELOG.md",
    "LICENSE",
    "index.json",
    "MANIFEST.txt",
    "FILES.md",
    "release-check.mjs",
    "UPDATE.md",
    "UPDATE-CORE.md",
    "UPDATE-GUIDE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "persona",
    "framework",
    "人格",
    "框架"
  ],
  "license": "MIT",
  "author": "dsh-persona-framework contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/re3uofall/dsh-persona-framework"
  },
  "homepage": "https://github.com/re3uofall/dsh-persona-framework#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  }
}
